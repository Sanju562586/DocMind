# DocMind Frontend — Environment Variables
# Copy this file to .env.local and populate with your credentials.

# ─── DocMind Backend API ───────────────────────────────────────────────────────
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=

# ─── Application URL & Session JWT Security ────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# 32+ character secure random string for JWT session token signing & encryption
AUTH_SECRET=your_nextauth_jwt_signing_secret_min_32_characters_here

# ─── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials
# Authorized Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# ─── GitHub OAuth ─────────────────────────────────────────────────────────────
# Create credentials in GitHub -> Developer Settings -> OAuth Apps
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here
