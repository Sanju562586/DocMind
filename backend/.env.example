# DocMind Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to git.

# ─── LLM API Keys ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─── LLM Model Names ───────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# ─── Storage Paths & Database ──────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
INDEX_DIR=./data/indexes
DATABASE_PATH=./data/summarizer.db
# Automatic Local Storage & Vector DB (Zero configuration required)
# DATABASE_URL is left empty/omitted so DocMind automatically uses embedded local storage & local Vector DB.
# DATABASE_URL=

# ─── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ─── Security / CORS ───────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Upload Limits ─────────────────────────────────────────────────────────────
MAX_FILE_SIZE_BYTES=52428800

# ─── Rate Limiting & Upstash Redis ─────────────────────────────────────────────
# Upstash Redis REST credentials (optional — falls back to local in-memory limiter if unset)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
REDIS_URL=

RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_SUMMARIZE=10/minute
RATE_LIMIT_COMPARE=10/minute
RATE_LIMIT_QUIZ=15/minute
RATE_LIMIT_URL=10/minute

# ─── Authentication & OAuth ────────────────────────────────────────────────────
AUTH_SECRET=your_auth_secret_key_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
